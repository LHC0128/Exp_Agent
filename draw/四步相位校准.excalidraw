"middle", "baseline": 12, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 738234834, "version": 1, "versionNonce": 1354663364, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "eDppIsFxoyPBcOOGxLcVa"}, {"type": "text", "x": 278, "y": 1556, "width": 1044, "height": 23, "text": "保存：hf2_snapshot → state[\"hf2_response_snapshot\"]", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "baseline": 12, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 967783219, "version": 1, "versionNonce": 1589369223, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "ng2qFHfXEPNxQ6uSXmbO_"}, {"type": "text", "x": 278, "y": 1588, "width": 1044, "height": 23, "text": "恢复：Temp_Switch → 5 V；state[\"phase_calibration_status\"]=completed", "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "baseline": 12, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 54553035, "version": 1, "versionNonce": 1594344267, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "TeE1Uja1cdAwejLxu--Pu"}, {"type": "rectangle", "x": 250, "y": 1618, "width": 1100, "height": 38, "angle": 0, "strokeColor": "#bcbcbc", "backgroundColor": "#f3f3f3", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 1572867949, "version": 1, "versionNonce": 1594534294, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": {"type": 3}, "id": "Uab_UthteR2eHCfpy-SNl"}, {"type": "text", "x": 274, "y": 1626, "width": 1052, "height": 22, "text": "→  ready for response + noise scan", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "baseline": 11, "angle": 0, "strokeColor": "#444444", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 488246905, "version": 1, "versionNonce": 372589779, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "BaQYOJglPTrTosWsdXKQg"}, {"type": "arrow", "x": 800.0, "y": 1662, "width": 0.0, "height": 58, "points": [[0, 0], [0.0, 58]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false, "angle": 0, "strokeColor": "#0b3d91", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 1935962909, "version": 1, "versionNonce": 509481573, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "id": "dIwyGFeGaa0gNdYpeEUjI"}, {"type": "rectangle", "x": 500, "y": 1726, "width": 600, "height": 60, "angle": 0, "strokeColor": "#0b3d91", "backgroundColor": "#dbe9ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 2046717035, "version": 1, "versionNonce": 2049799332, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": {"type": 3}, "id": "X97d32wwBS4XJsgL0Lg28"}, {"type": "text", "x": 500, "y": 1740, "width": 600, "height": 26, "text": "初始化完成 → 进入 Z RF 幅度响应 / 噪声扫描", "fontSize": 18, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "baseline": 15, "angle": 0, "strokeColor": "#0b3d91", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 1035486701, "version": 1, "versionNonce": 2023185960, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "_hmolKt7KrKxC8YTV4g_c"}, {"type": "rectangle", "x": 250, "y": 1816, "width": 1100, "height": 100, "angle": 0, "strokeColor": "#a16207", "backgroundColor": "#fff7d6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 427065393, "version": 1, "versionNonce": 1151839911, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": {"type": 3}, "id": "ga3QDSZerou5yiOC5xNX5"}, {"type": "text", "x": 274, "y": 1828, "width": 1052, "height": 23, "text": "注意：步骤 ③ 与 ④ 在代码中是同一次 calibrate_demod_phase(idx=3)，步骤 ④ 仅包含回读校验与结果应用，没有独立迭代。", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "baseline": 12, "angle": 0, "strokeColor": "#7c2d12", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 771508742, "version": 1, "versionNonce": 1591562961, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "xrEeLEL2dZw4YtpKRKiyw"}, {"type": "text", "x": 274, "y": 1860, "width": 1052, "height": 23, "text": "未做 Mx Z 实验式的 \"扫描 RF 触发相位 + 拟合 X+jY 复旋转\"，若 Z RF Burst 起始相位漂移显著，可参考 mx_z_optimal_control_rf_sensitivity 补一个相位扫描校准。", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "baseline": 12, "angle": 0, "strokeColor": "#7c2d12", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "z0", "seed": 1990699617, "version": 1, "versionNonce": 1487008924, "isDeleted": false, "boundElements": [], "updated": 1791531799779, "created": 1791531799779, "link": null, "locked": false, "roundness": null, "id": "PaT2BSMQctm71XidEeC7f"}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}