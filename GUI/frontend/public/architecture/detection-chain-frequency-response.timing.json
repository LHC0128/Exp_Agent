{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "探测链路频率响应标定 · 单频点采集时序",
    "locale": "zh-CN",
    "output": "detection-chain-frequency-response.timing.html",
    "viewBox": [
      1080,
