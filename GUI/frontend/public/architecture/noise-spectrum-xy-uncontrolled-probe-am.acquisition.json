  "cards": [
    {
      "dot": "cyan",
      "title": "两态配对细节",
      "items": [
        "相邻点交替先后：偶数点 OFF→ON，奇数点 ON→OFF",
        "每态切换后等待稳定再采集，段结束立即写 raw/",
        "第二段失败时保留第一段；无效波形离线剔除该数据对"
      ]
    },
    {
      "dot": "rose",
      "title": "同步与测量窗口",
      "items": [
        "Time_sequence_2 CH2 固定方波经三通触发 X/Y Burst",
        "每个控制点在温控关闭窗口内完成两态，结束后恢复温控",
        "DAQ 使用更短时间常数与更高采样率的采集解调参数"
      ]
    },
    {
      "dot": "emerald",
      "title": "可选 Z 可控噪声",
      "items": [
        "启用时额外上传 Z 任意波并在校相后开启",
        "主扫描全程不切换 Z 状态，仅两态配对切换 Probe AM",
        "收尾强制关闭 Z 通道并纳入安全限值校验",
        "收尾关闭 AM、载波与 Z 通道并恢复温控"
      ]
    }
  ]
}