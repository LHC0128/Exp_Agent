  "cards": [
    {
      "dot": "cyan",
      "title": "扫描与解调",
      "items": [
        "AM 频率逐点扫描（默认 50–130 kHz · 41 点），固定调制幅度；谱峰落在基带 |f_AM − f_ref|",
        "HF2 输入 0 关闭 AC 耦合、单端 50 Ω，解调与采样设置对照 XY 正弦控制噪声谱"
      ]
    },
    {
      "dot": "rose",
      "title": "温控门控",
      "items": [
        "每点采集期间温控开关输出 0 V，采集后在 finally 中恢复 5 V，不可被取消中断",
        "TEC103 可连接时设温并等待稳定；串口被外部软件占用时由外部软件维持温度"
      ]
    },
    {
      "dot": "emerald",
      "title": "安全与恢复",
      "items": [
        "输出前校验 safety_limits.yaml；已连接设备参考时钟统一外部参考，严格模式不一致即终止",
        "结束或取消后 AOM 两通道归零关输出、温控恢复 5 V ON、断开 TEC"
      ]
    }
  ]
