  "cards": [
    {
      "dot": "cyan",
      "title": "Probe AM 两态配对",
      "items": [
        "工作流逐点反算 X/Y 包络幅度并重触发 Burst",
        "每个控制点在同一温控窗口内采集 AM 噪声 OFF 与 ON 两态",
        "相邻点交替先后顺序：偶数点 OFF→ON，奇数点 ON→OFF",
        "每态等待稳定后由 HF2 DAQ 连续采集固定时长并立即落盘"
      ]
    },
    {
      "dot": "rose",
      "title": "仪器互连与同步",
      "items": [
        "Time_sequence_2 CH2 固定方波经三通触发 X/Y 控制 DG4000",
        "10 MHz 参考时钟覆盖全部信号源与 HF2（含 Probe AOM 源）",
        "预检强校验：载波与 AM 同机，Z 线圈与时序触发同机",
        "可选：向 Z 线圈持续注入已知可控噪声，主扫描全程状态不变"
      ]
    },
    {
      "dot": "emerald",
      "title": "测量口径与判据",
      "items": [
        "输出为 HF2 锁相测量端噪声谱，不换算为绝对 Probe 光功率",
        "无 K_Z 真值链与色散扫描；可选 Z 注入仅作背景压力测试",
        "背景 N_S1 与受控响应 S_beta 独立验收，差谱保留正负号"
      ]
    }
  ]
