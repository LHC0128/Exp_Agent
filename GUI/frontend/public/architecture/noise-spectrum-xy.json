  "cards": [
    {
      "dot": "cyan",
      "title": "扫描与校准流程",
      "items": [
        "目标 Ωctrl 轴按 Ω = K·|V| + B 反算正弦峰值,预检校验标定范围与 X/Y 安全限值",
        "温控关闭时先做 Demod0 校相,再以共享步骤迭代校准 XY Burst 相位,直到相位偏移收敛",
        "每点:X/Y OFF → set_amplitude 调幅 → 按校准相位重开并等待共用外触发 → 温控 OFF → DAQ 采集 → 恢复温控"
      ]
    },
    {
      "dot": "rose",
      "title": "仪器互连",
      "items": [
        "Time_sequence_2 CH2 固定方波经三通同时接 dg_comp CH1/CH2 Ext Trig,校相与扫描期间保持常开",
        "Pump 调制 DG4000:CH1 100 MHz 载波 + CH2 脉冲门控,经 RF 开关调制 Pump 光",
        "DG900 双通道 DC 设定 Pump/Probe 光功率;GS200 恒流驱动主磁场;连接的仪器统一 10 MHz 参考时钟"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与质量",
      "items": [
        "raw/ 保存 control_scan_axes.npz 与每点 waveform_C####.npy;DAQ 失败点存 NaN 并继续,不重试",
        "离线分析重新计算 Welch PSD,从移动脊线重标定 K/B,不沿用采集预设值",
        "局部拟合输出 S_beta 与 N_S1 及质量掩码;未通过验收的点保留 NaN,不插值外推"
      ]
    }
  ]
