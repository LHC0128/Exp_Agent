        "type": "number",
        "default": 450000.0,
        "unit": "Sa/s",
        "group": "advanced",
        "minimum": 1000.0,
        "maximum": null,
        "description": "",
        "read_only": false
      },
      {
        "name": "HF2_DAQ_TC_S",
