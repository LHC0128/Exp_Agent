    {
      "name": "Y_RF_FREQ_HZ",
      "label": "Y 向射频频率",
      "type": "number",
      "default": 5000.0,
      "unit": "Hz",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": null,
      "description": "Y 向射频正弦频率；脉冲周期按 1e6/f 自动确定（5 kHz → 200 µs），+π 与 −π 相隔半个周期。",
      "read_only": false
    },
    {
      "name": "Y_RF_VPP",
      "label": "Y 向射频幅度",
      "type": "number",
      "default": 0.05,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 1e-09,
      "maximum": 20.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PEAK_CURRENT_MA",
      "label": "脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "相对基线的 +π 峰值；−π 取相反号",
      "read_only": false
    },
    {
      "name": "Z_PULSE_EDGE_US",
      "label": "升/降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "升余弦沿；等效面积 = 宽度 − 沿宽",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_START_US",
      "label": "脉宽起点",
      "type": "number",
      "default": 4.0,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_STOP_US",
      "label": "脉宽终点",
      "type": "number",
      "default": 7.0,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_STEP_US",
      "label": "脉宽步进",
      "type": "number",
      "default": 0.5,
      "unit": "µs",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PULSE_PHASE_DEG",
      "label": "脉冲相位",
      "type": "number",
      "default": 90.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "脉冲串相对射频（即共同触发周期起点）的相位；按任意波数组循环移位实现，等效时间偏移 = 相位/360 × 脉冲周期。读出的幅度按 |cos(φ − ψ0)| 变化，ψ0 = 90° − 180° × 占空比（2.5% 时约 85.5°）：默认 90° 对应幅度最大，0° 附近是零点，判据峰位不受相位影响但信噪比差约 5 倍。",
      "read_only": false
    },
    {
      "name": "PHASE_CHECK_ENABLED",
      "label": "相位自检",
      "type": "boolean",
      "default": true,
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "扫描前先测当前相位与其 +90° 两点的 R，取较大者用于扫描；关闭则直接用 Z_PULSE_PHASE_DEG。",
      "read_only": false
    },
