    {
      "name": "PHASE_CHECK_ENABLED",
      "label": "相位粗扫",
      "type": "boolean",
      "default": true,
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "A03 按起点/终点/步进扫射频相位、取 R 峰作为 A04 的射频相位；关闭则 A03 跳过，A04 直接用 Y_RF_PHASE_DEG。只在单相位模式（SCAN_RF_PHASE_COUNT=1）生效，多相位模式下 A03 一律跳过。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_START_DEG",
      "label": "相位粗扫起点",
      "type": "number",
      "default": 0.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "射频相位粗扫的起点；只扫 0–180°，因为 |cos(φ − ψ0)| 的周期是 180°。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STOP_DEG",
      "label": "相位粗扫终点",
      "type": "number",
      "default": 180.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STEP_DEG",
      "label": "相位粗扫步进",
      "type": "number",
      "default": 22.5,
      "unit": "°",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "默认 0–180°、步进 22.5°，共 9 个角度；峰不在端点时按相邻三点做抛物线精化。",
      "read_only": false
    },
    {
      "name": "X_BIAS_V",
      "label": "X 静态偏置",
      "type": "number",
      "default": 0.0,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "A02 在 X 通道加的静态偏置；用来补掉残余横向场，把脉冲轴与自旋拉回 z。默认 0 表示不加偏置、通道保持关闭。本机实测 -0.02 V 可把 5 kHz 残留从 12.7 压到 3.9 mV。",
      "read_only": false
    },
    {
