    {
      "name": "Y_RF_FREQ_HZ",
      "label": "Y 向射频频率",
      "type": "number",
      "default": 5000.0,
      "unit": "Hz",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": null,
      "description": "Y 向射频正弦频率；脉冲周期按 1e6/f 自动确定（5 kHz → 200 µs），+π 与 −π 相隔半个周期。",
      "read_only": false
    },
    {
      "name": "Y_RF_VPP",
      "label": "Y 向射频幅度",
      "type": "number",
      "default": 0.05,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 1e-09,
      "maximum": 20.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_DEG",
      "label": "射频相位",
      "type": "number",
      "default": 90.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "多相位模式下是 A04 相位组的起点；单相位模式下是 A03 未运行或关闭时 A04 使用的固定射频相位。按 DG burst 相位写入。",
      "read_only": false
    },
    {
      "name": "SCAN_RF_PHASE_COUNT",
      "label": "每个脉宽的射频相位数",
      "type": "integer",
      "default": 4,
      "unit": "",
      "group": "basic",
      "minimum": 1,
      "maximum": 12,
      "description": "A04 在每个脉宽上依次测的射频相位个数，从 Y_RF_PHASE_DEG 起等间隔 360°/N。N ≥ 3 时 B01 解出 c0/c+1/c−1，用 |c−1| 峰位定 π，A03 跳过；N = 1 时为单相位 R 拟合（R 峰会随相位移动，仅作兼容）；N = 2 不足以分解，预检拒绝。",
      "read_only": false
    },
    {
      "name": "Z_PEAK_CURRENT_MA",
      "label": "脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "相对基线的 +π 峰值；−π 取相反号",
      "read_only": false
    },
    {
      "name": "Z_PULSE_EDGE_US",
      "label": "升/降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "升余弦沿；等效面积 = 宽度 − 沿宽",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_START_US",
      "label": "脉宽起点",
      "type": "number",
      "default": 2.0,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
