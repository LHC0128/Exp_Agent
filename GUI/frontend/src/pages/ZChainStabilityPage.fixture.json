    },
    {
      "name": "PULSE_EDGE_US",
      "label": "升/降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "升余弦沿；单脉冲面积 = (宽度 − 沿宽) × 峰值",
      "read_only": false
    },
    {
      "name": "PULSE_PEAK_CURRENT_MA",
      "label": "脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "advanced",
      "minimum": 0.1,
      "maximum": null,
      "description": "相对基线的 +π 峰值；−π 取相反号。默认按 K=653.79 Hz/mA 估为约 1.0π",
      "read_only": false
    },
    {
      "name": "PULSE_BASELINE_V",
      "label": "脉冲直流偏置",
      "type": "number",
      "default": 0.0,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "±π 脉冲所骑的 DG 直流偏置，与 A04 的基线目标无关；0 V 表示不写偏置，此时实测电流不为 0（功放零偏）",
