      "group": "advanced",
      "minimum": 2,
      "maximum": 20,
      "description": "",
      "read_only": false
    },
    {
      "name": "PULSE_DURATION_S",
      "label": "脉冲列持续时长",
      "type": "number",
      "default": 7200.0,
      "unit": "s",
      "group": "advanced",
      "minimum": 1,
      "maximum": 604800,
      "description": "",
      "read_only": false
    },
    {
      "name": "PULSE_TAIL_WINDOW_US",
      "label": "单脉冲积分窗",
      "type": "number",
      "default": 20.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 1,
      "maximum": null,
