      "default": 0.5,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 0.001,
      "maximum": 20.0,
      "description": "由 MFLI Signal Output 1（MF-MOD 载波）按峰值 Vpk = Vpp / 2 输出；11-25 实机记录 0.5 Vpp 饱和、0.05 Vpp 线性，默认取 0.05 Vpp。",
      "read_only": false
    },
    {
      "name": "X_BIAS_V",
      "label": "X 静态偏置",
      "type": "number",
