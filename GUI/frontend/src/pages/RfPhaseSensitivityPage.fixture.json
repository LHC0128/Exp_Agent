      "read_only": false,
      "options": [
        {
          "value": 50.0,
          "label": "50 Ω"
        },
        {
          "value": 1000000.0,
          "label": "1 MΩ"
        }
      ]
    },
    {
      "name": "AMPLIFIER_OUTPUT_IMPEDANCE_OHM",
      "label": "功放输出阻抗",
