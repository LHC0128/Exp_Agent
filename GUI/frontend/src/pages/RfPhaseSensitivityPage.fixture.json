      "unit": "mA",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "0 表示关闭；会话结束恢复原状态。",
      "read_only": false
    },
    {
      "name": "Z_PEAK_CURRENT_MA",
      "label": "Z 脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "仅功放链路的历史目标值；DG 直驱时电流按 Z_PULSE_VPP 与回路电阻估算，本键只用于读旧配置。",
      "read_only": false
    },
    {
      "name": "Z_PULSE_VPP",
      "label": "Z 脉冲幅度",
      "type": "number",
      "default": 20.0,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": 20.0,
      "description": "DG4000 直驱时写入 Z 通道的高阻档幅度；峰值为 Vpp/2，真实线圈电流按回路电阻估算；高阻档上限 20 Vpp。",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_US",
      "label": "Z 单个 π 脉冲宽度",
      "type": "number",
      "default": 9.0,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PULSE_EDGE_US",
      "label": "Z 脉冲升降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_TAIL_COMP_ENABLED",
