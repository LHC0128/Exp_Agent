      "default": false,
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "DG 直驱阶段默认关闭（只发原升余弦 ±脉冲）；开启后按Z_TAIL_S_F、Z_TAIL_TAU_E_US 计算反号指数尾。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_S_F",
