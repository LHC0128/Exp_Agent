      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_BIAS_V",
      "label": "Y 正弦直流偏置",
      "type": "number",
      "default": 0.0,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "叠加在 MFLI Signal Output 1 的直流偏置（sigouts/0/offset）。",
      "read_only": false
    },
    {
      "name": "MAIN_FIELD_CURRENT_MA",
