    {
      "name": "Y_RF_FREQ_HZ",
      "label": "Y 向射频频率",
      "type": "number",
      "default": 5000.0,
      "unit": "Hz",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": null,
      "description": "Y 向射频正弦频率；脉冲周期按 1e6/f 自动确定（5 kHz → 200 µs）。",
      "read_only": false
    },
    {
      "name": "Y_RF_VPP",
      "label": "Y 向射频幅度",
      "type": "number",
      "default": 0.05,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 1e-09,
      "maximum": 20.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_DEG",
      "label": "射频参考相位",
      "type": "number",
      "default": 0.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "A02 起振时的 burst 相位；相位扫描的起点由 Y_RF_PHASE_START_DEG 单独给定。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_START_DEG",
      "label": "相位扫描起点",
      "type": "number",
      "default": 0.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STOP_DEG",
      "label": "相位扫描终点",
      "type": "number",
      "default": 360.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "终点不写入：默认 0–360°、步进 15° 得到 24 个相位点，0° 与 360° 不重复。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STEP_DEG",
      "label": "相位扫描步进",
      "type": "number",
      "default": 15.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Z_PEAK_CURRENT_MA",
      "label": "脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "相对基线的 +π 峰值；−π 取相反号",
      "read_only": false
    },
    {
      "name": "Z_PULSE_EDGE_US",
      "label": "升/降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "升余弦沿；等效面积 = 宽度 − 沿宽",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_US",
      "label": "脉冲宽度",
      "type": "number",
      "default": 8.03,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "固定的单脉冲宽度；默认 8.03 µs 取自 pi_width_scan 的精确 π 波形。不能超过半个射频周期，且不小于两倍沿宽。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_COMP_ENABLED",
      "label": "Z 拖尾补偿",
      "type": "boolean",
      "default": true,
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "开启后每个 ±π 脉冲后接一段反号指数尾，使屏蔽筒慢响应在脉冲后抵消；尾幅按脉宽由 Z_TAIL_S_F、Z_TAIL_TAU_E_US 精确计算，τc = s_f·τe。关闭时为原升余弦脉冲。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_S_F",
      "label": "屏蔽模型快分量 s_f",
      "type": "number",
      "default": 0.544,
      "unit": "",
      "group": "basic",
      "minimum": 0.001,
      "maximum": 0.999,
      "description": "原子处 z 场中随电流瞬时出现的比例；其余 1 − s_f 以 τe 延迟到达。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_TAU_E_US",
      "label": "屏蔽模型时间常数 τe",
      "type": "number",
      "default": 46.9,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": 1000.0,
      "description": "慢分量的一阶时间常数；补偿尾的衰减时间 τc = s_f·τe。",
      "read_only": false
    },
    {
      "name": "X_BIAS_V",
      "label": "X 静态偏置",
      "type": "number",
      "default": -0.0409,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "A02 在 X 通道加的静态偏置，用来补掉残余横向场；默认取运行目录 pi_width_scan 精确 π 波形下的重标值。0 表示不加偏置、通道保持关闭。",
      "read_only": false
    },
    {
      "name": "Y_BIAS_V",
      "label": "Y 静态偏置",
      "type": "number",
      "default": -0.0069,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "叠加在 Y 向射频正弦上的直流 offset；默认取同一运行的重标值。",
      "read_only": false
    },
    {
