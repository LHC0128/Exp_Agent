          "MAIN_FIELD_CURRENT_MA",
          "Z_DRIVE_SOURCE_IMPEDANCE_OHM",
          "SENSE_RESISTOR_OHM",
          "DAMPING_RESISTOR_OHM",
          "COIL_RESISTANCE_OHM",
          "RESISTOR_RATED_W",
          "DEMOD0_IDX",
          "DEMOD0_SIGNAL_RANGE",
          "DEMOD0_ORDER",
          "DEMOD0_TC",
          "DEMOD0_RATE",
          "SET_TEC_TARGET",
