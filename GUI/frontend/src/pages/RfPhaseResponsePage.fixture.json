          "DEMOD0_SIGNAL_RANGE",
          "DEMOD0_ORDER",
          "DEMOD0_TC",
          "DEMOD0_RATE",
          "SET_TEC_TARGET",
          "TARGET_TEMPERATURE_C"
        ],
        "artifacts": [],
        "display_parameters": [
          "Y_RF_FREQ_HZ",
          "Y_RF_VPP",
          "Y_BIAS_V",
          "X_BIAS_V",
          "MAIN_FIELD_CURRENT_MA",
          "Z_DRIVE_SOURCE_IMPEDANCE_OHM",
          "SENSE_RESISTOR_OHM",
          "DAMPING_RESISTOR_OHM",
          "COIL_RESISTANCE_OHM",
          "RESISTOR_RATED_W",
          "DEMOD0_IDX",
          "DEMOD0_SIGNAL_RANGE",
