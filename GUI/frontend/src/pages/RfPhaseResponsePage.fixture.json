{
  "fields": [
    {
      "name": "RUN_TAG",
      "label": "运行标签",
      "type": "string",
      "default": "rf_phase_response",
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_FREQ_HZ",
      "label": "Y 向射频频率",
      "type": "number",
      "default": 5000.0,
      "unit": "Hz",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": null,
      "description": "MFLI MF-MOD Osc 2 载波频率，同时是 Z 双脉冲周期 1e6/f（5 kHz → 200 µs）与共同触发频率。",
      "read_only": false
    },
    {
      "name": "Y_RF_VPP",
      "label": "Y 向射频幅度",
      "type": "number",
      "default": 0.05,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 0.001,
      "maximum": 20.0,
      "description": "由 MFLI Signal Output 1（MF-MOD 载波）按峰值 Vpk = Vpp/2 输出；11-25 实机记录 0.5 Vpp 饱和、0.05 Vpp 线性，默认取 0.05 Vpp。",
      "read_only": false
    },
    {
      "name": "Y_BIAS_V",
      "label": "Y 静态偏置",
      "type": "number",
      "default": 0.08,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "叠加在 MFLI Signal Output 1 的直流偏置（sigouts/0/offset）。",
      "read_only": false
    },
    {
      "name": "X_BIAS_V",
      "label": "X 静态偏置",
      "type": "number",
      "default": 0.16,
      "unit": "V",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "DG X 通道的 DC 静态偏置，用来补掉残余横向场；0 表示不加偏置、通道保持关闭。",
      "read_only": false
    },
    {
      "name": "MAIN_FIELD_CURRENT_MA",
      "label": "主磁场电流",
      "type": "number",
      "default": -0.0655,
      "unit": "mA",
      "group": "basic",
      "minimum": -20.0,
      "maximum": 20.0,
      "description": "GS200 主磁场电流；0 表示关闭输出，非零时按该电流输出并回读，收尾恢复运行前状态。按 main_magnetic_field 安全限值校验。",
      "read_only": false
    },
    {
      "name": "Z_PEAK_CURRENT_MA",
      "label": "Z 脉冲峰值电流",
      "type": "number",
      "default": 190.0,
      "unit": "mA",
      "group": "basic",
      "minimum": 0.1,
      "maximum": null,
      "description": "仅功放链路的历史目标值；DG 直驱时电流按 Z_PULSE_VPP 与回路电阻估算，本键只用于读旧配置。",
      "read_only": false
    },
    {
      "name": "Z_PULSE_VPP",
      "label": "Z 脉冲幅度",
      "type": "number",
      "default": 20.0,
      "unit": "Vpp",
      "group": "basic",
      "minimum": 1e-06,
      "maximum": 20.0,
      "description": "DG4000 直驱时写入 Z 通道的高阻档幅度；峰值为 Vpp/2，真实线圈电流按回路电阻估算。高阻档上限 20 Vpp（峰峰值），预检超限即拒绝。",
      "read_only": false
    },
    {
      "name": "Z_PULSE_WIDTH_US",
      "label": "Z 单脉冲宽度",
      "type": "number",
      "default": 8.6,
      "unit": "µs",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "固定的单脉冲宽度；不能超过半个射频周期，且不小于两倍沿宽。",
      "read_only": false
    },
    {
      "name": "Z_PULSE_EDGE_US",
      "label": "升/降沿宽度",
      "type": "number",
      "default": 1.0,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.05,
      "maximum": null,
      "description": "升余弦沿；等效面积 = 宽度 − 沿宽",
      "read_only": false
    },
    {
      "name": "Z_TAIL_COMP_ENABLED",
      "label": "Z 拖尾补偿",
      "type": "boolean",
      "default": false,
      "unit": "",
      "group": "basic",
      "minimum": null,
      "maximum": null,
      "description": "开启后每个 ±π 脉冲后接一段反号指数尾，使屏蔽筒慢响应在脉冲后抵消；尾幅按脉宽由 Z_TAIL_S_F、Z_TAIL_TAU_E_US 精确计算，τc = s_f·τe。DG 直驱阶段默认关闭（只发原升余弦 ±脉冲）。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_S_F",
      "label": "屏蔽模型快分量 s_f",
      "type": "number",
      "default": 0.5,
      "unit": "",
      "group": "advanced",
      "minimum": 0.001,
      "maximum": 0.999,
      "description": "原子处 z 场中随电流瞬时出现的比例；其余 1 − s_f 以 τe 延迟到达。",
      "read_only": false
    },
    {
      "name": "Z_TAIL_TAU_E_US",
      "label": "屏蔽模型时间常数 τe",
      "type": "number",
      "default": 38.3,
      "unit": "µs",
      "group": "advanced",
      "minimum": 0.001,
      "maximum": 1000.0,
      "description": "慢分量的一阶时间常数；补偿尾的衰减时间 τc = s_f·τe。",
      "read_only": false
    },
    {
      "name": "AMPLIFIER_GAIN_DB",
      "label": "功放增益",
      "type": "number",
      "default": 20.0,
      "unit": "dB",
      "group": "advanced",
      "minimum": 0,
      "maximum": 20,
      "description": "历史功放链路的目标增益；DG 直驱时不使用，仅用于读旧配置。",
      "read_only": false
    },
    {
      "name": "AMPLIFIER_INPUT_IMPEDANCE_OHM",
      "label": "功放输入阻抗",
      "type": "number",
      "default": 1000000.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "历史功放链路参数；DG 直驱时不使用。",
      "read_only": false,
      "options": [
        {
          "value": 50.0,
          "label": "50 Ω"
        },
        {
          "value": 1000000.0,
          "label": "1 MΩ"
        }
      ]
    },
    {
      "name": "AMPLIFIER_OUTPUT_IMPEDANCE_OHM",
      "label": "功放输出阻抗",
      "type": "number",
      "default": 50.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "历史功放链路参数；DG 直驱时不使用，回路电阻改计 Z_DRIVE_SOURCE_IMPEDANCE_OHM。",
      "read_only": false,
      "options": [
        {
          "value": 50.0,
          "label": "50 Ω"
        },
        {
          "value": 1.0,
          "label": "1 Ω"
        }
      ]
    },
    {
      "name": "AMPLIFIER_WRITE_SETTINGS",
      "label": "连接时写入功放设置",
      "type": "boolean",
      "default": true,
      "unit": "",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "历史功放链路参数；DG 直驱时不使用。",
      "read_only": false
    },
    {
      "name": "Z_DRIVE_SOURCE_IMPEDANCE_OHM",
      "label": "DG 源阻抗",
      "type": "number",
      "default": 50.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": 0.0,
      "maximum": 1000000.0,
      "description": "DG 直驱时计入回路的信号源输出阻抗；DG4000 固定 50 Ω，按已知回路电阻估算线圈电流。",
      "read_only": false
    },
    {
      "name": "SENSE_RESISTOR_OHM",
      "label": "采样电阻",
      "type": "number",
      "default": 10.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "DAMPING_RESISTOR_OHM",
      "label": "阻尼电阻",
      "type": "number",
      "default": 10.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": 0,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "COIL_RESISTANCE_OHM",
      "label": "线圈直流电阻",
      "type": "number",
      "default": 2.0,
      "unit": "Ω",
      "group": "advanced",
      "minimum": 0,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "RESISTOR_RATED_W",
      "label": "电阻额定功率",
      "type": "number",
      "default": 2.0,
      "unit": "W",
      "group": "advanced",
      "minimum": 0.01,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "SCAN_POINT_DURATION_S",
      "label": "每点 MFLI 采集时长",
      "type": "number",
      "default": 0.2,
      "unit": "s",
      "group": "basic",
      "minimum": 0.05,
      "maximum": 1.0,
      "description": "共享整周扫描在每个相位点的连续采样时长；每点独立进出一次温控窗口。",
      "read_only": false
    },
    {
      "name": "SYSTEM_SETTLE_S",
      "label": "系统稳定等待",
      "type": "number",
      "default": 0.1,
      "unit": "s",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 4.0,
      "description": "关温控后、开始读数前的等待。",
      "read_only": false,
      "legacy_defaults": {}
    },
    {
      "name": "TEMP_SWITCH_ON_LAG_S",
      "label": "恢复温控后等待",
      "type": "number",
      "default": 2.0,
      "unit": "s",
      "group": "basic",
      "minimum": 0.1,
      "maximum": 30.0,
      "description": "每点恢复温控（5 V ON）并回读后的固定等待，之后才落盘。",
      "read_only": false
    },
    {
      "name": "DEMOD0_IDX",
      "label": "MFLI 读出解调器索引",
      "type": "integer",
      "default": 3,
      "unit": "",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "开启 MF-MOD 后 Demod 1–3 由调制器占用，原子读出固定使用 Demod 4（索引 3）。",
      "read_only": true
    },
    {
      "name": "DEMOD0_SIGNAL_RANGE",
      "label": "MFLI 输入量程",
      "type": "number",
      "default": 3.0,
      "unit": "V",
      "group": "advanced",
      "minimum": 0.001,
      "maximum": 3.0,
      "description": "Signal Input 1 的量程；按探测器信号幅度选择。",
      "read_only": false
    },
    {
      "name": "DEMOD0_ORDER",
      "label": "MFLI 滤波阶数",
      "type": "integer",
      "default": 4,
      "unit": "",
      "group": "advanced",
      "minimum": 1,
      "maximum": 8,
      "description": "",
      "read_only": false
    },
    {
      "name": "DEMOD0_TC",
      "label": "MFLI 时间常数",
      "type": "number",
      "default": 0.001,
      "unit": "s",
      "group": "advanced",
      "minimum": 1e-06,
      "maximum": 0.1,
      "description": "整周相位扫描的静态读出滤波时间常数。",
      "read_only": false
    },
    {
      "name": "DEMOD0_RATE",
      "label": "MFLI 解调传输率",
      "type": "number",
      "default": 10000.0,
      "unit": "Sa/s",
      "group": "advanced",
      "minimum": 100.0,
      "maximum": 60000.0,
      "description": "整周相位扫描的连续流传输率；低于 70 kSa/s 阈值，保持 DAQ 同步采集。",
      "read_only": false
    },
    {
      "name": "RF_DIRECTION",
      "label": "射频方向",
      "type": "string",
      "default": "Y",
      "unit": "",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "历史键：旧采集按此选择射频 burst 所在横向线圈；新采集射频固定由 MFLI Out1 输出到 Y，本键只用于读取旧配置。",
      "read_only": false,
      "options": [
        {
          "value": "Y",
          "label": "Y 向（默认）"
        },
        {
          "value": "X",
          "label": "X 向"
        }
      ]
    },
    {
      "name": "Y_RF_PHASE_DEG",
      "label": "历史射频参考相位",
      "type": "number",
      "default": 0.0,
      "unit": "°",
      "group": "advanced",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "历史键：旧采集 A02 起振时的 burst 相位；新采集载波相位由共享扫描逐点写入，本键只用于读旧配置。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_START_DEG",
      "label": "相位扫描起点",
      "type": "number",
      "default": 0.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STOP_DEG",
      "label": "相位扫描终点",
      "type": "number",
      "default": 360.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.0,
      "maximum": 360.0,
      "description": "终点不写入：默认 0–360°、步进 10° 得到 36 个相位点，0° 与 360° 不重复。",
      "read_only": false
    },
    {
      "name": "Y_RF_PHASE_STEP_DEG",
      "label": "相位扫描步进",
      "type": "number",
      "default": 10.0,
      "unit": "°",
      "group": "basic",
      "minimum": 0.001,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "N_REPEAT",
      "label": "历史每点重复次数",
      "type": "integer",
      "default": 1,
      "unit": "",
      "group": "advanced",
      "minimum": 1,
      "maximum": 200,
      "description": "历史键：旧采集每个相位的重复读数次数；新采集每点只取一帧、逐点独立温控，本键只用于读旧配置。",
      "read_only": false
    },
    {
      "name": "TEMP_GROUP_SIZE",
      "label": "历史温控分组点数",
      "type": "integer",
      "default": 2,
      "unit": "",
      "group": "advanced",
      "minimum": 1,
      "maximum": 200,
      "description": "历史键：旧采集每关闭温控一次连续采集的读数个数；新采集每点独立进出温控窗口，本键只用于读旧配置。",
      "read_only": false
    },
    {
      "name": "SET_TEC_TARGET",
      "label": "下发 TEC 目标温度",
      "type": "boolean",
      "default": false,
      "unit": "",
      "group": "advanced",
      "minimum": null,
      "maximum": null,
      "description": "",
      "read_only": false
    },
    {
      "name": "TARGET_TEMPERATURE_C",
      "label": "TEC 目标温度",
      "type": "number",
      "default": 90.0,
      "unit": "°C",
      "group": "advanced",
      "minimum": 20.0,
      "maximum": 130.0,
      "description": "只下发目标；不启停 TEC、不判稳。未启用时保留现场设定。",
      "read_only": false
    }
  ],
  "flow": {
    "run_step_id": "A03",
    "finish_step_id": "A04",
    "acquisition": [
      {
        "id": "A01",
        "title": "参数、映射与安全限值预检",
        "group": "准备",
        "dependencies": [],
        "parameters": [
          "RUN_TAG"
        ],
        "artifacts": [],
        "display_parameters": [
          "RUN_TAG"
        ],
        "quality_gates": [
          "不连接硬件；必需映射只含 Z_magnetic_field、X_magnetic_field、Time_sequence_2、Temp_Switch、lockin_r、main_magnetic_field 与 temperature；5 kHz 载波、Demod 4 读出、相位网格非空、脉宽大于两倍沿宽且不超过半个周期；MFLI Signal Output 1 的偏置与调相包络、Z_PULSE_VPP、按回路电阻估算的峰值电流、X/触发电平与电阻平均功耗全部在限内"
        ]
      },
      {
        "id": "A02",
        "title": "连接设备、同步 10 MHz 并准备 MF-MOD 载波",
        "group": "准备",
        "dependencies": [
          "A01"
        ],
        "parameters": [
          "Y_RF_FREQ_HZ",
          "Y_RF_VPP",
          "Y_BIAS_V",
          "X_BIAS_V",
