   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A08 电流轴 × 逐点 Y RF 扫频\n测量\n前置: A07",
   "originalText": "A08 电流轴 × 逐点 Y RF 扫频\n测量\n前置: A07",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 20,
   "containerId": null,
   "lineHeight": 1.25,
